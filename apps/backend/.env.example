APP_NAME=Infra Stack Lab API
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stack_lab

# Phase C — JWT validation (must match Keycloak realm + public SPA client)
OIDC_ISSUER_URL=http://localhost:8080/realms/learning
OIDC_EXPECTED_AZP=learning-spa
# Leave unset on the host so JWKS is fetched from localhost. In Docker Compose, default.env sets OIDC_JWKS_URL to http://keycloak:8080/...
# OIDC_JWKS_URL=http://keycloak:8080/realms/learning/protocol/openid-connect/certs
