# Docker Compose variable substitution (optional).
#
# Preferred: keep devops defaults in:
#   docker/backend/default.env
#
# For local overrides, copy one of:
#   docker/dev.env.sample
#   docker/backend/dev.env.sample
#   docker/frontend/dev.env.sample
#
# Then run:
#   docker compose --env-file docker/backend/default.env --env-file .env up --build
