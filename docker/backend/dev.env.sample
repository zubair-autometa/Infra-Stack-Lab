# Copy to a private file (never commit secrets), then run Compose with it:
#   cp docker/backend/dev.env.sample docker/backend/.env.local
#   docker compose --env-file docker/backend/default.env --env-file docker/backend/.env.local up --build
#
# Or merge into a single local file and use:
#   docker compose --env-file path/to/your.env up --build

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/stack_lab

KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_MASTER_CLIENT_SECRET=CHANGE_ME

# If you expose the UI on a different host/port, update CORS + Vite API URL + OIDC redirect URIs
# (Keycloak client must allow the same redirect / web origins).
# CORS_ORIGINS=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:8000
# OIDC_ISSUER_URL=http://localhost:8080/realms/learning
# OIDC_EXPECTED_AZP=learning-spa
