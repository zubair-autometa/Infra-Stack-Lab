# =============================================================================
# Docker / local stack defaults (committed). DevOps-related settings live here.
# Use with Compose from lab root:
#   docker compose --env-file docker/backend/default.env up --build
# =============================================================================

# --- PostgreSQL (used by postgres + backend DATABASE_URL) ---
POSTGRES_DB=stack_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
APP_NAME=Infra Stack Lab API
APP_ENV=docker
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/stack_lab

# --- Frontend build (Vite; baked at image build time) ---
VITE_APP_NAME=Infra Stack Lab
VITE_STAGE=docker
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_APP_ROUTE=true
VITE_AUTH_ENABLED=true
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/learning
VITE_OIDC_CLIENT_ID=learning-spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/signin-callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# --- Keycloak (Phase C; container env) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Application realm (users + public SPA) — imported from docker/keycloak/realm-learning.json
KEYCLOAK_REALM=learning
KEYCLOAK_USERS_REALM=learning
#
# Master realm — confidential backend-service (Import client from docker/keycloak/clients/master-backend-service.json).
# Used for client_credentials + Keycloak Admin REST API to manage users in realm "learning". NOT used by GET /api/me.
KEYCLOAK_MASTER_CLIENT_ID=backend-service
KEYCLOAK_MASTER_CLIENT_SECRET=2KBP3nvf1ZzjNdhlgmN4qNg15uf5hqlN

# --- API JWT validation (same issuer the browser uses; azp = public SPA client) ---
OIDC_ISSUER_URL=http://localhost:8080/realms/learning
OIDC_EXPECTED_AZP=learning-spa
# From inside the API container, reach Keycloak by Compose service name (JWT iss is still localhost for browser tokens).
OIDC_JWKS_URL=http://keycloak:8080/realms/learning/protocol/openid-connect/certs

# --- Redis (reserved; not wired in this lab yet) ---
REDIS_PORT=6379
REDIS_DEFAULT_TTL=3600
REDIS_CHARSET=utf-8

# --- OPA (reserved; not wired in this lab yet) ---
OPA_PORT=8181
OPA_PACKAGE=api/main
