# Vite build-time variables for the frontend image.
# For the full stack, `docker/backend/default.env` already includes these keys
# so one `--env-file` is enough. This file documents frontend-only overrides.

VITE_APP_NAME=Infra Stack Lab
VITE_STAGE=docker
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_APP_ROUTE=true
VITE_AUTH_ENABLED=false
