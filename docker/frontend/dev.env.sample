# Copy to a private file for local frontend image builds, e.g.:
#   docker compose --env-file docker/backend/default.env --env-file docker/frontend/.env.local build frontend
#
# Typical overrides when your API is not on localhost:8000:
# VITE_API_BASE_URL=https://api.mycompany.test

VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_ENABLED=true
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/learning
VITE_OIDC_CLIENT_ID=learning-spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/signin-callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
